{"fpc_inf_to_flag1"
	{"ables"
		{remove talk}
	}
	{"action"
		{drop orders}
		{action advance}
		{target
			{tag fpc1}
		}
	}
	{"actor_state"
		{move_mode free}
		{movement
			{speed fast}
			{kind fast}
			{type normal}
		}
		{ai
			{no_retreat on}
		}
	}
	{"entity_state"
		{tag_remove cmp_def}
	}
	{"ables"
		{add talk}
	}
}
