
{"fpc_inf_react1"
	{"while"
		{condition
			{type entities}
			{selector
				{tag fpc_react1}
				{state "not dead"}
			}
		}
		{"entity_state"
			{selector
				{source standart}
				{amount 1
				}
				{tag fpc_react1}
				{state "not dead"}
			}
			{tag_add fpc_selected1}
			{tag_remove fpc_react1}
		}
		{"call"
		{function "fpc_inf_to_flag1"}
			{context
				{specified}
				{selector
					{source standart}
					{tag fpc_selected1}
				}
			}
		}
		{"delay"
			{time 0.1}
		}
		{"entity_state"
			{selector
				{source standart}
				{tag fpc_selected1}
			}
			{tag_remove fpc_selected1}
		}
	}
}
