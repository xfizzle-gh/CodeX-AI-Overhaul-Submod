{"attack_at_tank_charge"
	{"action"
		{drop "orders sensor senseless"}
		{action attack}
		{target
			{amount 1}
			{tag _z_tank_target}
		}
		{volume engine}
	}
	{"actor_state"
		{movement
			{speed assault}
			{kind fast}
			{type normal}
		}
		{ai {no_retreat on}}
	}
	{"entity_state"
		{selector {source standard} {tag _z_tank_inf}}
		{tag_add _z_charge_ordered}
		{tag_remove _z_tank_inf}
	}
	{"entity_state"
		{selector {source standard} {tag _z_tank_target}}
		{tag_remove _z_tank_target}
	}
	{"delay" {time 7}}
	{"entity_state"
		{selector {source standard} {tag _z_charge_ordered}}
		{tag_remove _z_charge_ordered}
	}
}

{"attack_at_inf_grenade"
	{"action"
		{drop "orders sensor senseless"}
		{action attack}
		{target
			{amount 1}
			{tag _z_inf_target}
		}
		{volume engine}
	}
	{"actor_state"
		{movement
			{speed assault}
			{kind fast}
			{type normal}
		}
		{ai {no_retreat on}}
	}
	{"entity_state"
		{selector {source standard} {tag _z_inf_thrower}}
		{tag_add _z_grenade_ordered}
		{tag_remove _z_inf_thrower}
	}
	{"entity_state"
		{selector {source standard} {tag _z_inf_target}}
		{tag_remove _z_inf_target}
	}
	{"delay" {time 6}}
	{"entity_state"
		{selector {source standard} {tag _z_grenade_ordered}}
		{tag_remove _z_grenade_ordered}
	}
}



{"attack_stop_orders"
	{"actor_state"
		{drop orders}
		{ai
			{no_retreat on}
			{advance_ratio "0.01"}
		}
	}
}
; === v1.064 prep default_spawns (from vanilla) ===

			{"default_spawns"
				{"spawn"
					{entity "conquest_spawn_helper"}
					{waypoint "0"}
					{disable_random_spawn_position}
				}
				{"delay"
					{time 0.01}
				}
				{"entity_state"
					{selector
						{source standart}
						{ignore_captured_by_user 0}
						{amount 1
						}
						{tag conquest_spawn_helper}
					}
					{tag_add _default_a1}
