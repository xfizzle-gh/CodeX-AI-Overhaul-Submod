;SDL
actor
(include "abm.inc")
(include "mobility.inc")
(include "vehicle.ext")
(include "armor.ext")
(include "tank_crew.ext")
;(include "vehicle_hotmod.ext")
{collider "tank.medium"}
{props "tank" "hatch" "engine" "antifire" "standart_netting"}
{PatherID "tank"}

("brain_vehicle")
; OH: define locally so later vehicle.ext stack overrides cannot drop the macro Code:X calls.
(define "recoil_side_volumes"
	{volume "recoil_gun_front"{component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_left" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_right" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_back" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_baleft" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_baright" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_frright" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{volume "recoil_gun_frleft" {component "recoil_gun"}{thickness 30}{tags "gun_recoil"}{able clear {NoWoundDecal}}}
	{component "recoil_gun"}
)
("recoil_side_volumes") ;//add by ordos
{hearingBias 4.5} 	;// reduces units ability to hear sound signals. value = meters

{sensor
	{visor "main"
		{vision "tank_main-l"}
		{bone "visor1"}
	}
	{Visor "driver"
		{vision "tank_driver"}
		{bone "visor2"}
	}
	;{visor "around"
	;	;{vision "tank_around"}
	;	{vision "tank_around_small"}
	;	{bone "visor1"}
	;}
	;{visor "commander"
	;	{vision "tank_commander"}
	;	{bone "visor1"}
	;}
	;{visor "human"
	;	{vision "human"}
	;	{bone "visor3"}
	;}
	{visor "none"
		{vision "none"}
	}
	{visor "hearing"
		{vision "noise_detection"}
		{bone "hearing_bone"}
	}
	;{RememberTime 45}
}

{Skeleton
	{bone "hearing_bone"
		{Position 0 0 70}
	}
}





{extender "inventory"
	{box
		{Size 9 16}
		{Weight 15000}
		{item "can" 2}
		{item "repair_kit" 10}
		{item "fire_extinguisher" 3}
		{item "netting_kit" 5}
				{item "nbk39 grenade" 4}
	}
}

{extender "talk"
	{talker "tank"}
}
{able "talk"}

{Chassis "track"
	; left track must be first
	{FuelBag
		{volume 250 }	;// liters
		{rate   10 }	;// liters per kilometer
		{remain 250 }
		{fuel "fuel"}
	}
}

("basic_armor" args 20)

("body" repair(130))
("engine" repair(45))
("tracks" repair(30) thickness(20))

("general_durability" body(250) engine(150) turret(150) mantlet(150) gun(150) track(150) ammo(120))

{perks {blastwave_modifier 6.0}}

;----------------add by ordos--------------
	                                          	

(define "ERA_element"		
	{Volume "d_a%0" {tags "d_a" "d_a_1gen"  } 
			{able clear {contact 1} {contact_ground 1} {bullet 1}{BLAST 1}} 
			{component "d_a%0"}
	}		
	{Volume "comp_d_a%0" {tags "1gen_ERA"  } 
			{able clear {NoWoundDecal}} 
			{component "d_a%0"}
	}		
			{component "d_a%0" {tags "d_a"}}	
)		

(define "ERA_element_2gen"
	{Volume "d_a%0" {tags "d_a" "d_a_2gen" }
			{able clear {contact 1} {contact_ground 1} {bullet 1}{BLAST 1}}
			{component "d_a%0"}
	}
	{Volume "comp_d_a%0" {tags "2gen_ERA"  }
			{able clear {NoWoundDecal}}
			{component "d_a%0"}
	}		
			{component "d_a%0" {tags "d_a"}}
)

