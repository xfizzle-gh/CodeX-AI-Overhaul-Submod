(define "d_a_Kontakt1"		
	("1gen_ERA")	      		
	{armor			
		{setting "d_a"				
			{thickness 10}				
			{durability {blast {koef 12}} {pierce {value 16}}}				
			{threshold {blast {koef 1}} {pierce {koef 2} 	{calibre 6}}}				
			{volumes "d_a*"}			
		}			
		{setting "comp_d_a"	
			{thickness 50}				
			{durability {blast {koef 30}} 
				{pierce {value 100}}
			}				
			{threshold {blast {koef 10}} {pierce {koef 20} 	{calibre 6}}}				
			{volumes "comp_d_a*"}			
		}		
	}	
)

