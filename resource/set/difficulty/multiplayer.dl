{difficulty
	(include "difficulty_generic.inc")
	{any
		{death_delay_min 200}		; min bleeding out time in seconds
		{death_delay_max 300}		; max bleeding out time in seconds

		{burst 0.75}					; multiplier to number of bullets in burst from weapon settings
		{health 1.0}				; health multiplier from soldier settings
		{accuracy 0.95}
	}
}
