(define "bot_state"
	{unitset
		{value "conquest"}
		{available "all infantry sniper armor light medium heavy artillery airborne mechanized"}
	}
	(include "presets/global_parameters/unitlimits_gos_ai.inc")
	(include "presets/global_parameters/budgets_gos_ai.inc")
	{balancingFactorBonus {cp %cp} {mpStart 1.0} {mpFinish 1.0} {payback %payback}} ;// overridden in dynamic campaign difficulty files
)

{game
	{order -1}
	{parameters	"points_table_player=0/0.000,0.333/0.416,0.5/0.555,0.667/0.667,1.00/0.833;points_table_ai=0/0.000,0.333/0.139,0.50/0.167,0.667/0.208,1.00/0.277;flag_capture_time=75;flag_release_time=25;flag_capture_factor=0.9;kill_score_multiplier=0"}
	;rate to time to reach score if 1000
	;0.139	=	120min
	;0.167	=	100min
	;0.208	=	80min
	;0.277	=	60min
	;0.333	=	50min
	;0.416	=	40min
	;0.555	=	30min
	;0.667	=	25min
	;0.833	=	20min
	{settings
		{difficulty				multiplayer}
		{scoreFinal				900}
		{preparationTime		1200}	; seconds (20 min). Official prep phase when player defends (v1.064+)
		{pauseDuringPreparation	false}	; simulation runs during prep
		{impregnableTimeout		5}	; seconds
		{floraRespawn			0}
		{friendlyFire			0}
		{showPiercing			1}
		{showDamageReports		1}
		{enableBots				1}
		{randomSpawnPoints		1}
		{useManualCharge		none}
	}
	{teamSettings
		{teamsMode normal}
		{armySelectionMode alliance}
		{teams
			{"a"
				{minTeamSlots 7}
				{aiTeamPlayers 1}
			}
			{"b" {minTeamSlots 1}}
		}
		{alliances
			(include "presets/alliances_generic.inc")
		}
	}
	{ranked
		{enabled}
	}
	{presets
		{"d:campaign"
			{gameMode "campaign"}
			{unitMode "all"}
			{ranked}
			{common
				{unitset
					{value "conquest"}
					{available "all infantry sniper armor light medium heavy artillery airborne mechanized"}
				}
				(include "presets/global_parameters/unitlimits_gos_player.inc")
				(include "presets/global_parameters/budgets_gos.inc")
			}
			{bots
				{easy
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{normal
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{hard
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{heroic
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
			}
		}
	}
}
