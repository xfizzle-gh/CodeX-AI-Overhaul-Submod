		{value "conquest"}
		{available "all infantry sniper armor light medium heavy artillery airborne mechanized"}
	}
	{unitLimits ""}
	{chargeFactors
		{value "*=0"}
		{customize "0;0.5;1.0;1.5;2.0;2.5;5.0;10.0"}
	}
	{budgets
		{vehicle
			{mode "standard"}
			{resource
				{start      %mpStart}
				{finish     %mpFinish}
				{growTime   1}
				{growTable  "1"}
				{payback
					{cp         "0      10      20      30      40      51"}
					{restore    "0      0       0       0       0       0"}
				}
			}
			{buttons "inf1 inf2 inf3 support1 support2 vehicle1 vehicle2 tank1 tank2 gun1 gun2"}
		}
	}
	{balancingFactorBonus {cp %cp} {mpStart 1.0} {mpFinish 1.0} {payback %payback}}
)

{game
	{order -1}
	{parameters "points_table_player=0/0.000,0.33/0.277,0.50/0.333,0.66/0.416,1.00/0.555;points_table_ai=0/0.000,0.33/0.277,0.50/0.333,0.66/0.416,1.00/0.555;flag_capture_time=75;flag_release_time=25;flag_capture_factor=0.9;kill_score_multiplier=0.25"}
	{settings
		{difficulty             multiplayer}
		{scoreFinal             900}
