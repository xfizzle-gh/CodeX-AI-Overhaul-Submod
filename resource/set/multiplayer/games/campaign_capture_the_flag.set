(define "bot_state"
	{unitset
		{value "conquest"}
		{available "all infantry sniper armor light medium heavy artillery airborne mechanized"}
	}
	(include "presets/global_parameters/unitlimits_gos_ai.inc")
	(include "presets/global_parameters/budgets_gos_ai.inc")
	{balancingFactorBonus {cp %cp} {mpStart 1.0} {mpFinish 1.0} {payback %payback}} ;// overridden in dynamic campaign difficulty files
)

{game
	{order -1}
	{parameters	"points_table_player=0/0.000,0.33/5.000,0.50/6.000,0.66/8.000,1.00/10.000;points_table_ai=0/0.000,0.33/5.000,0.50/6.000,0.66/8.000,1.00/10.000;flag_capture_time=75;flag_release_time=25;flag_capture_factor=0.9;kill_score_multiplier=6.00"}
	; integer pts/sec so sub-second ticks cannot floor to 0. 8500 @ 100% hold ~14 min.
	; kills still mix in. Do not rely on last-kill remainder to land on scoreFinal.
	{settings
		{difficulty				multiplayer}
		{scoreFinal				8500}
		{preparationTime		1200}	; seconds (20 min). Official prep phase when player defends (v1.064+)
		{pauseDuringPreparation	false}	; simulation runs during prep
		{impregnableTimeout		5}	; seconds
		{floraRespawn			0}
		{friendlyFire			0}
		{showPiercing			1}
		{showDamageReports		1}
		{enableBots				1}
		{randomSpawnPoints		1}
		{useManualCharge		none}
	}
	{teamSettings
		{teamsMode normal}
		{armySelectionMode alliance}
		{teams
			{"a"
				{minTeamSlots 7}
				{aiTeamPlayers 1}
			}
			{"b" {minTeamSlots 1}}
		}
		{alliances
			(include "presets/alliances_generic.inc")
		}
	}
	{ranked
		{enabled}
	}
	{presets
		{"d:campaign"
			{gameMode "campaign"}
			{unitMode "all"}
			{ranked}
			{common
				{unitset
					{value "conquest"}
					{available "all infantry sniper armor light medium heavy artillery airborne mechanized"}
				}
				(include "presets/global_parameters/unitlimits_gos_player.inc")
				(include "presets/global_parameters/budgets_gos.inc")
			}
			{bots
				{easy
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{normal
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{hard
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
				{heroic
					("bot_state" cp(1.00) mpStart(1) mpFinish(1) payback(0.0))
				}
			}
		}
	}
}
