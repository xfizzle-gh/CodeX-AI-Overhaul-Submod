;SDL
; NATO doctrine-specific MP and DP rosters.
; United States units use American personnel and equipment only.
; European units use NATO-European personnel and equipment only.

;===============================================================================
; UNITED STATES JOINT FORCE
; Marines, Army, armored cavalry, airborne reconnaissance, Rangers, armor, fires and air.
;===============================================================================

; Normal MP infantry shown only when the United States doctrine is selected.
{"squad_usmc_rifle(nato)"
	("mp_infantry_7" side(nato) period(2022s) d(modern_nato_usa) c1(usmc_squadlead:1) c2(usmc_teamlead:3) c3(usmc_mg_m27:3) c4(usmc_grenadier:3) c5(usmc_marksman:1) c6(usmc_rifleman:1) c7(usmc_medic:1))
}

