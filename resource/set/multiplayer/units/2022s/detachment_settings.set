;SDL
; Small dismounted teams use the inf2 purchase tab so they remain visually
; separate from full infantry squads during incremental roster testing.

(define "detachment_with1type"
	{"%name(%side)"
		{charge {delay 0}{interval 0}}
		{content "mp/%side/%period/%c1"}
		{tags "conquest conquestonly %side %period detachment"}
		{level 1}
		{cost 0}
		{research_stage %min_stage}
		{research_stage_max %max_stage}
		{squad_cost_factor 1}
		{button "inf2"}
	}
)

(define "detachment_with2types"
	{"%name(%side)"
		{charge {delay 0}{interval 0}}
		{content "mp/%side/%period/%c1 mp/%side/%period/%c2"}
		{tags "conquest conquestonly %side %period detachment"}
		{level 1}
		{cost 0}
		{research_stage %min_stage}
		{research_stage_max %max_stage}
		{squad_cost_factor 1}
		{button "inf2"}
	}
)

(define "detachment_with3types"
	{"%name(%side)"
		{charge {delay 0}{interval 0}}
		{content "mp/%side/%period/%c1 mp/%side/%period/%c2 mp/%side/%period/%c3"}
		{tags "conquest conquestonly %side %period detachment"}
		{level 1}
		{cost 0}
		{research_stage %min_stage}
		{research_stage_max %max_stage}
		{squad_cost_factor 1}
		{button "inf2"}
	}
)
