;SDL
; Skirmish doctrine cards, doctrine-gated MP units, and doctrine-point choices.

; Selection cards do not charge MP for their display formation.
(define "generic_d_inf"
	{level 1}
	{research_stage 1}
	{squad_cost_factor 0}
	{tags "all doctrine %t"}
	{button "doctrine"}
)

(define "squad_with2types_doctrine"
	("generic_d_inf" t(%side %period))
	{content "mp/%side/%period/%c1 mp/%side/%period/%c2"}
)

(define "squad_with4types_doctrine"
	("generic_d_inf" t(%side %period))
	{content "mp/%side/%period/%c1 mp/%side/%period/%c2 mp/%side/%period/%c3 mp/%side/%period/%c4"}
)

(define "squad_with5types_doctrine"
	("generic_d_inf" t(%side %period))
	{content "mp/%side/%period/%c1 mp/%side/%period/%c2 mp/%side/%period/%c3 mp/%side/%period/%c4 mp/%side/%period/%c5"}
)

; Doctrine-gated MP infantry. Full squads use inf1; detachments use inf2.
(define "generic_mp_doctrine_unit"
	{level 1}
	{research_stage 1}
	{research_stage_max 99}
	{tags "conquest conquestonly %t"}
	{charge {delay 0}{interval 0}}
	{cost 0}
	{squad_cost_factor 1}
	{button "inf1"}
	{doctrine %d}
)

(define "generic_mp_doctrine_team"
	{level 1}
	{research_stage 1}
	{research_stage_max 99}
	{tags "conquest conquestonly %t detachment"}
	{charge {delay 0}{interval 0}}
	{cost 0}
	{squad_cost_factor 1}
	{button "inf2"}
	{doctrine %d}
)

; Shared NATO line infantry is available under either NATO doctrine and uses a
