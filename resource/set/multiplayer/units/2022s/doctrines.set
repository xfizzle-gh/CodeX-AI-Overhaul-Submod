;SDL
; Two curated doctrines per selectable army.
; Unit IDs match Code:X interface image basenames wherever Code:X supplies a
; doctrine icon. PRC uses explicit aliases added by this stack.

; NATO: Expeditionary Force
{"doctrine(nato)"
	("squad_with2types_doctrine" side(nato) period(2022s) c1(nato_squadlead:1) c2(nato_rifleman:5))
	("doctrine_t1" cool(0) d(modern_nato) cost(10))
}

; NATO: Armored Brigade support infantry
{"doctrine_vehicle_m2a3(nato)"
	("squad_with4types_doctrine" side(nato) period(2022s) c1(inf2_squadlead:1) c2(inf2_teamlead:2) c3(inf2_autorifle:2) c4(inf2_antitank:2))
	("doctrine_t1" cool(0) d(modern_nato_armored) cost(10))
}

