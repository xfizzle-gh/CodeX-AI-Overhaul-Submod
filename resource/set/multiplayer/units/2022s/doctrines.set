{"doctrine_squad_dsh(rusa)"
	("squad_with5types_doctrine" side(rusa) period(2022s) c1(106vdv_squadlead:1) c2(106vdv_rifleman:3) c3(106vdv_mg:2) c4(106vdv_antitank:1) c5(106vdv_medic:1))
	("doctrine_t1" cool(0) d(modern_rusa_vdv) cost(10))
}

; PRC: 112th Rapid Combined Arms
{"doctrine_squad_skirmish_prc(prc)"
	("squad_with2types_doctrine" side(prc) period(2022s) c1(pla_squadlead:1) c2(pla_rifleman:5))
