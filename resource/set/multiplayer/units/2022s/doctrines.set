;SDL
; Two full combined-arms doctrine identities per selectable army.
; Doctrine identifiers begin with a letter because {doctrine %d} expects an ident.

; NATO: United States Joint Force
{"doctrine(nato)"
	("squad_with2types_doctrine" side(nato) period(2022s) c1(usmc_squadlead:1) c2(usmc_rifleman:5))
	("doctrine_t1" cool(0) d(modern_nato_usa) cost(10))
}

; NATO: European Coalition
{"doctrine_vehicle_m2a3(nato)"
	("squad_with4types_doctrine" side(nato) period(2022s) c1(gb_squadlead:1) c2(gb_rifleman:3) c3(gb_mg:1) c4(gb_antitank:1))
	("doctrine_t1" cool(0) d(modern_nato_eu) cost(10))
}

; Ukraine: National Defense Forces
{"doctrine(ukr)"
	("squad_with2types_doctrine" side(ukr) period(2022s) c1(ukr_squadlead:1) c2(ukr_rifleman:5))
	("doctrine_t1" cool(0) d(modern_ukr_home) cost(10))
}

; Ukraine: Western Mechanized Corps
{"doctrine_squad_47th(ukr)"
	("squad_with5types_doctrine" side(ukr) period(2022s) c1(ukr47_squadlead:1) c2(ukr47_seniorrifleman:1) c3(ukr47_lmg:1) c4(ukr47_antitank_h:1) c5(ukr47_rifleman:3))
	("doctrine_t1" cool(0) d(modern_ukr_western) cost(10))
}

